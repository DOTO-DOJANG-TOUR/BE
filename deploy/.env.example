# 실제 값은 EC2의 /opt/app/.env에만 저장합니다. 이 파일에는 시크릿을 넣지 마세요.

# CD가 배포 시 ECR 이미지 주소로 갱신합니다.
APP_IMAGE=<terraform-output-ecr_repository_url>:develop-abcdef0

# PostgreSQL 컨테이너와 Spring 앱이 공통으로 사용합니다.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Spring Boot 운영 환경 변수
JWT_SECRET=replace-with-a-long-random-secret
TOUR_API_SERVICE_KEY=
GOOGLE_OIDC_CLIENT_ID=
KAKAO_OIDC_CLIENT_ID=

# DNS A 레코드가 EC2 Elastic IP를 가리킨 뒤 true로 변경합니다.
DOMAIN_NAME=doto-app.cloud
LETSENCRYPT_EMAIL=your-email@example.com
ENABLE_TLS=false
